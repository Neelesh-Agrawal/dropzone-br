{
  "name": "dropzone-br",
  "version": "1.0.0",
  "description": "DROPZONE - Browser-based 3D Multiplayer Battle Royale",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:smoke": "node scripts/smoke.mjs",
    "test:combat": "tsx scripts/combat.test.ts",
    "test:match": "tsx scripts/match.test.ts",
    "server": "tsx server/index.ts",
    "start": "concurrently \"npm run server\" \"npm run dev\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.19.2",
    "three": "^0.165.0",
    "tsx": "^4.10.5",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "@types/three": "^0.165.0",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.63.0"
  }
}
